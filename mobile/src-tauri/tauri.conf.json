{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Two-edged Sword",
  "version": "0.1.0",
  "identifier": "com.wayned.two-edged-sword",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1432",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Two-edged Sword",
        "width": 390,
        "height": 844,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.png"
    ],
    "resources": {
      "../../src-tauri/modules/kjv.bbli": "modules/kjv.bbli",
      "../../src-tauri/modules/kjv+.bbli": "modules/kjv+.bbli",
      "../../src-tauri/modules/bsb.bbli": "modules/bsb.bbli",
      "../../src-tauri/modules/web.bbli": "modules/web.bbli",
      "../../src-tauri/modules/strong.lexi": "modules/strong.lexi",
      "../../src-tauri/modules/tsk.cmti": "modules/tsk.cmti",
      "../../src-tauri/modules/easton.dcti": "modules/easton.dcti",
      "../../src-tauri/modules/jfb.cmti": "modules/jfb.cmti",
      "../../src-tauri/modules/barnes.cmti": "modules/barnes.cmti"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 28
    }
  }
}
