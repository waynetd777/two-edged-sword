<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.tes_mobile" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Android's own splash: the app's navy alone. The logo (wider than Android lets a splash icon be)
             comes in with the app's cover (TesNativePlugin.kt), as on the page's opening screen. -->
        <item name="android:windowSplashScreenBackground">#1B2532</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_none</item>
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
