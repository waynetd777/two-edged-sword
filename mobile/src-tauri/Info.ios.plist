<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the icon: "Two-edged Sword" is too wide, and iOS squeezes out its space. -->
	<key>CFBundleDisplayName</key>
	<string>2-edged Sword</string>
	<!-- iPhone: upright, except while a picture is open full screen. Every orientation the app may use is
	     listed here; the tes-native plugin answers iOS with the ones allowed at the moment. iPad turns freely. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Reading aloud carries on with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Modules brought in from elsewhere (lib.rs import_waiting): AirDrop and Files offer "Open in 2-edged
	     Sword" for these file types, which iOS copies to Documents/Inbox; and Finder shows the app's Documents
	     folder (Files on a Mac with the device plugged in), so a module can be dragged there. The types are
	     e-Sword's own (net.e-sword.bbli and the rest): with e-Sword installed, iOS knows the files by its
	     names, and offers this app beside it only if this app names them too. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.bbli</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Bible</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bbli</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.cmti</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Commentary</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cmti</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.dcti</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Dictionary</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dcti</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.lexi</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Lexicon</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lexi</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.refi</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Book</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>refi</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.e-sword.devi</string>
			<key>UTTypeDescription</key>
			<string>Two-edged Sword Devotional</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>devi</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Two-edged Sword module</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.e-sword.bbli</string>
				<string>net.e-sword.cmti</string>
				<string>net.e-sword.dcti</string>
				<string>net.e-sword.lexi</string>
				<string>net.e-sword.refi</string>
				<string>net.e-sword.devi</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
