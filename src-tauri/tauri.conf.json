{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Two-edged Sword",
  "version": "1.2.10",
  "identifier": "com.wayned.two-edged-sword",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "python3 tools/core/build.py --if-missing && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Two-edged Sword",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      },
      {
        "label": "tray",
        "url": "index.html?view=tray",
        "title": "Two-edged Sword",
        "width": 340,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net https://itunes.apple.com; frame-src 'self' https: http:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5OEEwNkNDMTJFNTI5RDcKUldUWEtlVVN6QWFLR1hRL2VXRVcrNnRVZEZhT05EM0xQNERhTHE5YjRQOHZZMTU2VjJXVGdWVEQK",
      "endpoints": ["https://github.com/waynetd777/two-edged-sword/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Wayne Davies. Free software under the GNU General Public License, version 3 or later.",
    "targets": [
      "app"
    ],
    "resources": {
      "modules/*": "modules/",
      "variances/*": "variances/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
