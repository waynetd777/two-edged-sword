{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Two-edged Sword",
  "version": "1.0.9",
  "identifier": "com.wayned.two-edged-sword",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 tools/helpbook.py && python3 tools/core/build.py --if-missing && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Two-edged Sword",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Wayne Davies. Free software under the GNU General Public License, version 3 or later.",
    "targets": [
      "app"
    ],
    "resources": {
      "modules/*": "modules/",
      "variances/*": "variances/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/Two-edged Sword.help": "gen/help/Two-edged Sword.help"
      }
    }
  }
}
